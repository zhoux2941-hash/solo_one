{
  "name": "can-reid",
  "version": "1.0.0",
  "description": "CAN Bus Reverse Engineering & Intrusion Detection System",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc src/main.ts --outDir dist --module commonjs --target ES2020 --esModuleInterop --strict --skipLibCheck",
    "build:preload": "tsc src/preload.ts --outDir dist --module commonjs --target ES2020 --esModuleInterop --strict --skipLibCheck",
    "build:renderer": "webpack --config webpack.config.js",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:rust": "cd can-backend && cargo build --release",
    "start": "npm run build && electron .",
    "dev": "webpack serve --config webpack.config.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.5.0",
    "css-loader": "^6.8.0",
    "electron": "^28.0.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
