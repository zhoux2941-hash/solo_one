<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fulfillment.order.mapper.OrderItemMapper">

    <resultMap id="BaseResultMap" type="com.fulfillment.order.entity.OrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="product_id" property="productId"/>
        <result column="product_name" property="productName"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="total_price" property="totalPrice"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_order_item (order_id, order_no, product_id, product_name, price, quantity, total_price)
        VALUES (#{orderId}, #{orderNo}, #{productId}, #{productName}, #{price}, #{quantity}, #{totalPrice})
    </insert>

    <insert id="batchInsert">
        INSERT INTO t_order_item (order_id, order_no, product_id, product_name, price, quantity, total_price)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.orderId}, #{item.orderNo}, #{item.productId}, #{item.productName}, #{item.price}, #{item.quantity}, #{item.totalPrice})
        </foreach>
    </insert>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT * FROM t_order_item WHERE order_id = #{orderId}
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM t_order_item WHERE order_no = #{orderNo}
    </select>

</mapper>