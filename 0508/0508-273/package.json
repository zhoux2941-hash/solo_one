{
  "name": "video-processor-wasm",
  "version": "0.1.0",
  "description": "WebAssembly video processing library with face detection and background replacement",
  "main": "index.js",
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "build:release": "wasm-pack build --target web --out-dir pkg --release",
    "dev": "node server.js",
    "serve": "node server.js"
  },
  "keywords": ["webassembly", "wasm", "video", "face-detection", "rust"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "express": "^4.18.2"
  },
  "dependencies": {
    "@tensorflow-models/face-landmarks-detection": "^1.0.5",
    "@tensorflow/tfjs": "^4.17.0"
  }
}
