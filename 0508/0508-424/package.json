{
  "name": "nfc-access-control-system",
  "version": "1.0.0",
  "description": "NFC门禁卡模拟与审计系统",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "rebuild": "electron-rebuild -f -w nfc-pcsc"
  },
  "author": "NFC Security Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "nfc-pcsc": "^0.8.1",
    "better-sqlite3": "^9.2.2",
    "@pokusew/pcsclite": "^0.6.0",
    "pdfkit": "^0.14.0",
    "chart.js": "^3.5.1",
    "chartjs-node-canvas": "^4.1.6",
    "moment": "^2.29.4",
    "events": "^3.3.0"
  },
  "build": {
    "appId": "com.nfc.accesscontrol",
    "productName": "NFC门禁卡系统",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
