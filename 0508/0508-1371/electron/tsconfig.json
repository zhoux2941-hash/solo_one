{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "outDir": "../dist-electron",
    "rootDir": "../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@/*": ["../electron/main/*"]
    }
  },
  "include": [
    "../electron/**/*.ts",
    "../src/shared/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../dist-electron",
    "../src/renderer/**/*.ts",
    "../src/renderer/**/*.tsx"
  ]
}
